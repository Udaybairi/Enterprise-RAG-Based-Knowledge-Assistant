# ---------------------------------------------------------------------------
# Enterprise RAG Knowledge Assistant - backend configuration
# Copy to backend/.env and fill in the secrets. Never commit .env files.
# ---------------------------------------------------------------------------
ENVIRONMENT=development            # development | test | production
LOG_LEVEL=INFO
LOG_JSON=false
CORS_ORIGINS=http://localhost:3000

# --- Security -------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=480
ALLOW_REGISTRATION=true
FIRST_USER_IS_ADMIN=true
# Optional: create an admin on startup
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=300
RATE_LIMIT_CHAT=30
RATE_LIMIT_UPLOAD=30
RATE_LIMIT_AUTH=20
RATE_LIMIT_WINDOW_SECONDS=60

# --- Storage --------------------------------------------------------------
# PostgreSQL in production; SQLite file is used when unset.
# DATABASE_URL=postgresql+psycopg://rag:rag@localhost:5432/rag
DATA_DIR=./data
MAX_UPLOAD_SIZE_MB=50

# --- LLM provider ---------------------------------------------------------
# gemini = Google Gemini (production). fake = deterministic offline provider (tests/demo without a key).
LLM_PROVIDER=gemini
GOOGLE_API_KEY=
# Model IDs are configurable; the backend calls the Gemini models.list API on startup and reports
# availability under GET /api/settings. "-latest" aliases track Google's current stable models.
GEMINI_CHAT_MODEL=gemini-flash-latest
GEMINI_UTILITY_MODEL=gemini-flash-lite-latest
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=768
GENERATION_TEMPERATURE=0.1
GENERATION_MAX_OUTPUT_TOKENS=2048
EMBEDDING_BATCH_SIZE=50
EMBEDDING_MAX_RETRIES=6
EMBEDDING_REQUESTS_PER_MINUTE=1200

# --- Vector store ---------------------------------------------------------
VECTOR_STORE=chroma                # chroma | faiss

# --- Chunking -------------------------------------------------------------
CHUNKING_STRATEGY=structure        # recursive | token | semantic | structure
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
SEMANTIC_BREAKPOINT_PERCENTILE=90
SEMANTIC_BUFFER_SIZE=1

# --- Retrieval ------------------------------------------------------------
RETRIEVAL_STRATEGY=hybrid          # semantic | hybrid | mmr | keyword
RETRIEVAL_TOP_K=6
RETRIEVAL_FETCH_K=24
# Cosine similarity floor. Gemini embeddings: ~0.45-0.6 works well; tune with the evaluation page.
SIMILARITY_THRESHOLD=0.45
MMR_LAMBDA=0.6
HYBRID_ALPHA=0.6
RERANKER=lexical                   # none | lexical | llm
MULTI_QUERY_COUNT=3
ENABLE_QUERY_REWRITING=true
MAX_CONTEXT_TOKENS=12000

# --- Workers --------------------------------------------------------------
INGESTION_WORKERS=2

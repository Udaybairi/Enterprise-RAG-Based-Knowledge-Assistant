# ---------------------------------------------------------------------------
# Enterprise RAG Knowledge Assistant - backend configuration
# Copy to backend/.env and fill in the secrets. Never commit .env files.
# ---------------------------------------------------------------------------
ENVIRONMENT=development            # development | test | production
LOG_LEVEL=INFO
LOG_JSON=false
CORS_ORIGINS=http://localhost:3000
# CORS_ORIGIN_REGEX=^https://my-frontend(-[a-z0-9-]+)?\.vercel\.app$
# Serverless mode is switched on automatically on Vercel (see docs/DEPLOY_VERCEL.md).
# SERVERLESS=false

# --- Security -------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=480
ALLOW_REGISTRATION=true
# First registered account becomes admin: unset = on in development, OFF in production.
# In production create the first admin with BOOTSTRAP_ADMIN_* or `python -m app.manage create-admin`.
# FIRST_USER_IS_ADMIN=
# Optional: create an admin on startup
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=300
RATE_LIMIT_CHAT=30
RATE_LIMIT_UPLOAD=30
RATE_LIMIT_AUTH=20
RATE_LIMIT_WINDOW_SECONDS=60
# Reverse proxies in front of the API that append to X-Forwarded-For (0 = ignore the header).
# Unset = 1 on Vercel, 0 elsewhere. Behind nginx/a load balancer set 1 (and FORWARDED_ALLOW_IPS for uvicorn).
# TRUSTED_PROXY_HOPS=0

# --- Storage --------------------------------------------------------------
# PostgreSQL in production; SQLite file is used when unset.
# DATABASE_URL=postgresql+psycopg://rag:rag@localhost:5432/rag
DATA_DIR=./data
FILE_STORAGE=local                 # local | database (database = files kept in Postgres; serverless)
MAX_UPLOAD_SIZE_MB=50

# --- LLM provider ---------------------------------------------------------
# gemini = Google Gemini (production). fake = deterministic offline provider (tests/demo without a key).
LLM_PROVIDER=gemini
GOOGLE_API_KEY=
# Model IDs are configurable; the backend calls the Gemini models.list API on startup and reports
# availability under GET /api/settings. "-latest" aliases track Google's current stable models.
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
GEMINI_UTILITY_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash
GEMINI_THINKING_LEVEL=low
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=768
GENERATION_TEMPERATURE=0.1
GENERATION_MAX_OUTPUT_TOKENS=2048
EMBEDDING_BATCH_SIZE=50
EMBEDDING_MAX_RETRIES=6
EMBEDDING_REQUESTS_PER_MINUTE=1200

# --- Vector store ---------------------------------------------------------
VECTOR_STORE=chroma                # chroma | faiss | pgvector (pgvector needs a PostgreSQL DATABASE_URL)

# --- Chunking -------------------------------------------------------------
CHUNKING_STRATEGY=structure        # recursive | token | semantic | structure
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
SEMANTIC_BREAKPOINT_PERCENTILE=90
SEMANTIC_BUFFER_SIZE=1

# --- Retrieval ------------------------------------------------------------
RETRIEVAL_STRATEGY=hybrid          # semantic | hybrid | mmr | keyword
RETRIEVAL_TOP_K=6
RETRIEVAL_FETCH_K=24
# Cosine similarity floor, calibrated for gemini-embedding-001@768 (see docs/EVALUATION.md).
# Re-calibrate with `python -m app.evaluation.pipeline_eval` after changing the embedding model.
SIMILARITY_THRESHOLD=0.58
MMR_LAMBDA=0.6
HYBRID_ALPHA=0.6
RERANKER=lexical                   # none | lexical | llm
MULTI_QUERY_COUNT=3
QUERY_EXPANSION=adaptive           # always | adaptive | off
EXPANSION_MARGIN=0.05
ENABLE_QUERY_REWRITING=true
MAX_CONTEXT_TOKENS=12000

# --- Workers --------------------------------------------------------------
INGESTION_WORKERS=2

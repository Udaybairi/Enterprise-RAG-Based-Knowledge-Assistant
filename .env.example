# Used by docker-compose. Copy to .env and fill in secrets (never commit .env).
GOOGLE_API_KEY=
JWT_SECRET_KEY=change-me-to-a-long-random-secret-at-least-32-chars
ENVIRONMENT=production
LLM_PROVIDER=gemini
GEMINI_CHAT_MODEL=gemini-flash-latest
GEMINI_UTILITY_MODEL=gemini-flash-lite-latest
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=768
VECTOR_STORE=chroma
POSTGRES_PASSWORD=change-me
PUBLIC_API_URL=http://localhost:8000
PUBLIC_WEB_URL=http://localhost:3000
# Optional first admin
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
